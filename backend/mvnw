#!/bin/sh
MVN_VERSION=3.9.11
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MVN_HOME="$BASE_DIR/.mvn/apache-maven-$MVN_VERSION"
if [ ! -x "$MVN_HOME/bin/mvn" ]; then
  echo "Maven nao encontrado localmente. Baixando Maven $MVN_VERSION..."
  mkdir -p "$BASE_DIR/.mvn"
  ZIP="$BASE_DIR/.mvn/maven.zip"
  curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MVN_VERSION/apache-maven-$MVN_VERSION-bin.zip" -o "$ZIP" || exit 1
  unzip -q "$ZIP" -d "$BASE_DIR/.mvn" || exit 1
  rm -f "$ZIP"
fi
exec "$MVN_HOME/bin/mvn" "$@"
